---
import { Icon } from "astro-icon/components";

interface FilterTab {
	value: string;
	label: string;
	icon?: string;
	count?: number;
}

interface Props {
	tabs: FilterTab[];
	dataAttr: string;
	activeValue?: string;
	class?: string;
}

const {
	tabs,
	dataAttr,
	activeValue = "all",
	class: className = "",
} = Astro.props;
---

<div class:list={["filter-tabs", className]}>
	{
		tabs.map((tab) => (
			<button
				class:list={[
					"filter-tabs-item",
					{ active: tab.value === activeValue },
				]}
				data-filter-value={tab.value}
				data-filter-attr={dataAttr}
			>
				{tab.icon && <Icon name={tab.icon} class="text-base w-4 h-4" />}
				<span>{tab.label}</span>
				{tab.count !== undefined && (
					<span class="filter-tabs-count">({tab.count})</span>
				)}
			</button>
		))
	}
</div>

<style>
	/* 使用 :global() 确保 JS 动态重建的标签也能匹配样式 */
	:global(.filter-tabs) {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
	}

	:global(.filter-tabs-item) {
		display: inline-flex;
		align-items: center;
		gap: 0.375rem;
		padding: 0.5rem 1rem;
		border: 1px solid color-mix(in oklch, var(--primary) 25%, transparent);
		border-radius: var(--radius-large);
		background: color-mix(in oklch, var(--primary) 10%, transparent);
		color: var(--primary);
		font-size: 0.875rem;
		font-weight: 500;
		cursor: pointer;
		transition: all 0.2s ease;
		white-space: nowrap;
	}

	:global(.filter-tabs-item) iconify-icon {
		flex-shrink: 0;
		opacity: 0.8;
		transition: opacity 0.2s ease;
	}

	:global(.filter-tabs-item):hover:not(.active) {
		background: color-mix(in oklch, var(--primary) 18%, transparent);
		border-color: color-mix(in oklch, var(--primary) 45%, transparent);
	}

	:global(.filter-tabs-item):hover:not(.active) iconify-icon {
		opacity: 1;
	}

	:global(.filter-tabs-item).active {
		background: var(--primary);
		color: white;
		border-color: var(--primary);
	}

	:global(.filter-tabs-item).active iconify-icon {
		opacity: 1;
	}

	:global(.filter-tabs-count) {
		opacity: 0.6;
		font-size: 0.8rem;
	}

	@media (width < 768px) {
		:global(.filter-tabs) {
			gap: 0.375rem;
		}

		:global(.filter-tabs-item) {
			padding: 0.4rem 0.8rem;
			font-size: 0.8rem;
		}

		:global(.filter-tabs-count) {
			display: none;
		}
	}
</style>
